# JS OS — environment variables. Copy this file to .env; server.js reads it on startup.
# On Vercel, set the same names in the project settings instead.

# ── Google Gemini (JS AI). Get a key at https://aistudio.google.com ──
GEMINI_API_KEY=YOUR-KEY-HERE
GEMINI_MODEL=gemini-3.6-flash

# ── Server ──
PORT=8080
# ALLOWED_ORIGINS=https://example.com      # extra origins allowed to use the API and sockets (comma separated)
# TRUST_PROXY=true                         # a reverse proxy in front adds X-Forwarded-For (automatic on Vercel)
# LOG_FORMAT=pretty                        # or json (the default on Vercel)
# MAX_PER_IP=50                            # simultaneous connections per IP address (raise behind a shared NAT)

# ── JSTube ──
# TUBE_PLAYER=auto                         # auto = built-in player except on Vercel · native · embed (YouTube iframe)
# YTDLP_PATH=/usr/local/bin/yt-dlp         # pin your own yt-dlp; otherwise the latest release is downloaded into .cache/ and refreshed weekly
# JSOS_CACHE_DIR=./.cache                  # where the downloaded yt-dlp and its cache live

# ── JS Call connectivity (WebRTC) ──
# STUN alone connects most home networks directly. Strict firewalls (schools, offices, some phone
# carriers) need a TURN relay for the audio. Two ways to get one:
#
# 1) Built-in relay, for self-hosting. Forward these ports on your router to this machine, or set UPNP=true:
#      TCP <PORT>                 the JS OS website
#      UDP+TCP <TURN_PORT>        the relay's control port
#      UDP <TURN_RELAY_PORTS>     the relayed audio
# TURN_PORT=3478
# TURN_RELAY_PORTS=49160-49223
# PUBLIC_HOST=my-home.duckdns.org          # hostname or IP people use to reach you (default: whatever address they browsed to)
# PUBLIC_IP=203.0.113.5                    # your public IPv4 (auto-detected through STUN when empty)
# UPNP=true                                # ask the router to forward the ports above automatically
# TURN_SECRET=change-me                    # optional fixed secret for relay credentials (random on every start when empty)
#
# 2) External relay, for Vercel or any hosted TURN service (coturn, Metered, Twilio, ...):
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_USERNAME=user                       # static credentials ...
# TURN_PASSWORD=pass
# TURN_SECRET=shared-secret                # ... or a coturn "use-auth-secret" secret for time-limited ones
#
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
